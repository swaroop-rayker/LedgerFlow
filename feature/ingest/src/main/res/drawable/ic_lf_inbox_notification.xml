<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar icon for the inbox notification (SPEC.md §5.1). P2-7.

  Lucide's `inbox` since design-system step F4 (ADR-0031; ISC licence in
  :core:designsystem's assets/licenses/Lucide-ISC.txt): the app's one icon
  family, so the notification draws the same tray the app does.

  White on transparency is not a style choice: Android keeps only the alpha
  of a small icon and tints it to the shade, so `LfTheme` has no say here.

  An inbox tray rather than a rupee or a bell: the notification is about the
  approval queue, and the queue is what tapping it opens. A currency glyph
  would also be wrong in every install that picks a different base currency
  at onboarding (§5.8).

  Stroked, as the family draws it. The icon this replaced was filled, from a
  worry that strokes render unevenly when the system rescales a small icon;
  that is a device check (design-system F4), not an assumption.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M22 12L16 12L14 15L10 15L8 12L2 12" />
    <path
        android:strokeColor="#FF000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z" />
</vector>
