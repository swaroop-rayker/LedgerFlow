<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar icon for the inbox notification (SPEC.md §5.1). P2-7.

  A flat white silhouette on transparency, which is not a style choice: Android
  takes the alpha channel of a small icon and discards every colour in it, so
  anything with fill detail arrives as a white blob. `LfTheme` has no say here
  for the same reason — the system tints this to match the shade, not the app.

  An inbox tray rather than a rupee or a bell: the notification is about the
  approval queue, and the queue is what tapping it opens. A currency glyph would
  also be wrong in every install that picks a different base currency at
  onboarding (§5.8).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!--
      The tray: an outer rounded box, with the mouth of the tray cut by the
      shoulder path below it. Drawn as one filled outline plus one subtractive
      shape rather than as strokes, because a stroked vector at 24dp renders
      unevenly once the system rescales it for a status bar.
    -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M19,3H5C3.9,3 3,3.9 3,5v14c0,1.1 0.9,2 2,2h14c1.1,0 2,-0.9 2,-2V5C21,3.9 20.1,3 19,3zM19,15h-4c0,1.66 -1.35,3 -3,3s-3,-1.34 -3,-3H5V5h14V15z" />

    <!--
      The arrow into the tray. This is the half that says "something arrived"
      rather than "here is a folder", and it is why the glyph reads at 18px.
    -->
    <path
        android:fillColor="#FF000000"
        android:pathData="M12,13.5l3.5,-3.5h-2.5V6.5h-2v3.5h-2.5z" />

</vector>
