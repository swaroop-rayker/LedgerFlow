<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      Package visibility for the allowlist editor's "Add an app" list
      (V2-PLAN 3.4, AndroidInstalledApps): launcher apps, and the apps that
      handle SMS so the editor can warn before one is added. Never
      QUERY_ALL_PACKAGES, which Play restricts. No permission is added.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>
</manifest>
