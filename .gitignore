# ── NEVER COMMIT THESE ────────────────────────────────────────────────────
# Committing signing material means rotating the key, which means you can
# never update an already-installed app. The `guards` CI job greps for these.
keystore.properties
local.properties
*.jks
*.keystore
*.p12
google-services.json
play-service-account.json
secrets.properties

# ── Build output ──────────────────────────────────────────────────────────
build/
*/build/
.gradle/
.kotlin/
local.build/
captures/
out/
*.apk
*.aab
*.ap_
*.dex
*.class
mapping.txt
*.hprof

# ── Android Studio / IntelliJ ─────────────────────────────────────────────
.idea/*
!.idea/codeStyles/
!.idea/inspectionProfiles/
!.idea/icon.png
*.iml
.navigation/
.externalNativeBuild/
.cxx/

# ── Roborazzi / screenshot scratch (goldens ARE committed, via LFS) ───────
**/build/outputs/roborazzi/
**/screenshots/diff/
**/screenshots/actual/

# ── Macrobenchmark output ─────────────────────────────────────────────────
benchmark/build/outputs/

# ── OS noise ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Local scratch ─────────────────────────────────────────────────────────
/scratch/
*.log

# Generated: Room schemas are synced here so MigrationTestHelper can read them
# from the test APK's assets. The committed source of truth is
# core/database/schemas/ (see core/database/build.gradle.kts).
core/database/src/androidTest/assets/
