<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      SPEC.md §5.1's inbox notification, which is a runtime permission at API
      33+ (P2-7).

      Not restricted, and wanted by BOTH flavours: the notification announces a
      pending_transaction row, and playSafe produces those from notification
      ingest exactly as smsFull does from SMS. So it belongs in src/main, where
      it merges into both — unlike RECEIVE_SMS, which is Play-restricted and
      lives in feature/ingest/src/smsFull/ alone (D-04).

      It is declared here rather than in :feature:ingest, which posts the
      notification, so that that module's manifest can keep its absolute "no
      uses-permission element in this file" rule. `restrictedPermissionCheck`
      pins the full set per source set, so neither this line nor its absence
      elsewhere depends on anyone remembering.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      allowBackup=false is mandatory (SPEC.md §7.5). Android Auto Backup copies
      the encrypted database but cannot copy the Keystore key, so a restore onto
      a new device yields an undecryptable database. LedgerFlow ships its own
      phrase-derived .lfbk backup instead, which is device-independent.
    -->
    <application
        android:name=".LedgerFlowApplication"
        android:allowBackup="false"
        android:label="LedgerFlow"
        android:supportsRtl="true"
        android:theme="@style/Theme.LedgerFlow">

        <!--
          launchMode="singleTop" arrives with the deep link (P2-7).

          Without it, tapping a notification while the app is already open
          creates a SECOND MainActivity over the first, and the user backs out
          of the review screen into a stale copy of the app. With it the running
          instance receives the intent through onNewIntent, which is where
          MainActivity re-reads the link. A single-Activity app (§9.3) has no
          other Activity for this to affect.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.LedgerFlow"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              SPEC.md §5.1's `ledgerflow://inbox/{pendingId}`.

              BROWSABLE is deliberately ABSENT. §5.1 specifies the URI the
              notification opens; it does not ask for a link any web page or
              QR code on the phone can fire into the user's ledger. Without
              that category the scheme is not reachable from a browser, and
              our own PendingIntent — which sets the package explicitly —
              resolves through this filter regardless.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="ledgerflow" android:host="inbox" />
            </intent-filter>
        </activity>

        <!--
          WorkManager's own initialiser is removed on purpose (SPEC.md §5.1).

          Its default provider runs at content-provider time, before Hilt has a
          graph, and installs a worker factory that cannot construct an
          @HiltWorker, so ParseIngestWorker would fail to instantiate at runtime
          with nothing at compile time to say so. LedgerFlowApplication
          implements Configuration.Provider instead, which also keeps
          WorkManager's database off the cold-start path (§11).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
